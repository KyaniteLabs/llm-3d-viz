# Catalog refresh — official APIs only
# Get free AA key: https://artificialanalysis.ai/data-api
AA_API_KEY=
OPENROUTER_API_KEY=
# SKIP_ARENA=1

# Optional: auto-publish to the public Cloudflare Pages site on each catalog refresh.
# Requires THREE things to fire: DEPLOY_PAGES=1 + CLOUDFLARE_API_TOKEN + PAGES_PROJECT.
# Without DEPLOY_PAGES=1, public publish stays manual/approval-gated (npm run deploy:pages).
# Create a token at https://dash.cloudflare.com/profile/api-tokens (Cloudflare Pages:Edit).
DEPLOY_PAGES=
CLOUDFLARE_API_TOKEN=
PAGES_PROJECT=llm-3d-viz
PAGES_BRANCH=main
